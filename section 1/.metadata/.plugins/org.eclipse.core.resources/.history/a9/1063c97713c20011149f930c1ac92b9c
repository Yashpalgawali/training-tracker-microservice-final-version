package com.example.demo.service.impl;

import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.example.demo.repository.CompanyRepository;
import com.example.demo.service.ICompanyService;
import com.example.demo.dto.CompanyDto;
import com.example.demo.entity.Company;
import com.example.demo.exception.GlobalException;
import com.example.demo.exception.ResourceAlreadyExistsException;
import com.example.demo.exception.ResourceNotFoundException;
import com.example.demo.mapper.CompanyMapper;

import lombok.RequiredArgsConstructor;

@Service("compserv")
@RequiredArgsConstructor
public class CompanyServImpl implements ICompanyService {

	private final CompanyRepository comprepo;
	
	@Override
	public void createCompany(CompanyDto companyDto) {
		
		if(companyDto.getCompanyName()=="") {
			throw new RuntimeException("Company name can't be blank");
		}
		
		Optional<Company> found = comprepo.findByCompanyName(companyDto.getCompanyName());
		if(found.isPresent()) {
			throw new ResourceAlreadyExistsException("Company","Name",companyDto.getCompanyName());
		}
		
		Company company = CompanyMapper.mapToCompany(companyDto, new Company());

		Company savedCompany = comprepo.save(company);
		if(savedCompany==null) {
			throw new GlobalException("Company "+company.getCompanyName()+" is not created");
		}
	}

	@Override
	public CompanyDto getCompanyById(Long companyId) {
		
		Company result = comprepo.findById(companyId).orElseThrow(()-> new ResourceAlreadyExistsException("Company", "ID", String.valueOf(companyId)));
		return CompanyMapper.mapToCompanyDto(result, new CompanyDto());
	}

	@Override
	public CompanyDto getCompanyByName(String companyName) {
		Company result = comprepo.findByCompanyName(companyName).orElseThrow(()-> new ResourceAlreadyExistsException("Company", "ID", companyName));
		return CompanyMapper.mapToCompanyDto(result, new CompanyDto());
	}

	@Override
	public List<CompanyDto> getAllCompanies() {
		var list = comprepo.findAll();
		if(list.size() < 0) {
			throw new ResourceNotFoundException("Company", "List", null);
		}
		return list.stream().map(comp-> {
			CompanyDto compDto = new CompanyDto();
			compDto.setCompanyId(comp.getCompanyId());
			compDto.setCompanyName(comp.getCompanyName());
			return compDto;
		}).collect(Collectors.toList());		
	}

	@Override
	public void updateCompanyDto(CompanyDto companyDto) {
		if(companyDto.getCompanyName()=="") {
			throw new GlobalException("Company name can't be blank");
		}		 
		Company mappedCompany = CompanyMapper.mapToCompany(companyDto, new Company());
		Company savedCompany = comprepo.save(mappedCompany);
		if(savedCompany==null) {
			throw new GlobalException("Company "+companyDto.getCompanyName()+" is not updated");
		}
	}

}
